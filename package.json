{
  "name": "dsh-wsl-terminal",
  "version": "1.0.0",
  "description": "Ctrl+C/Ctrl+V copy-paste and a WSL-aware Ctrl+` terminal launcher for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md",
    "shell/DshTerminalShell.cs",
    "shell/build.ps1",
    "shell/dsh-terminal-shell.exe"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "test:isolated": "node --test test/",
    "verify": "pnpm run format:check && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsimba/dsh-wsl-terminal.git"
  },
  "homepage": "https://github.com/kingsimba/dsh-wsl-terminal#readme",
  "bugs": {
    "url": "https://github.com/kingsimba/dsh-wsl-terminal/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "terminal",
    "wsl",
    "copy-paste"
  ],
  "author": "kingsimba",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
